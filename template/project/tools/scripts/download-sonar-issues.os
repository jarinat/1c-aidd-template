#Использовать cmdline

Перем ФайлНастроек;
Перем КаталогРезультатов;

// Этот script — единственный read-only entrypoint выгрузки Sonar issues.
// Он не выводит токен и не меняет сущности SonarQube. Для MR review помимо
// issues он сохраняет фактическое evidence текущего анализа, если SonarQube
// его предоставляет. Отсутствие evidence не является доказательством свежести.

// Возвращает значение sonar.projectKey из файла настроек
//
// Возвращаемое значение:
//   Строка - идентификатор проекта в SonarQube
//
Функция ПолучитьProjectKey()

	ФайлКонфигурации = Новый Файл(ФайлНастроек);
	Если НЕ ФайлКонфигурации.Существует() Тогда
		Сообщить("Не найден файл конфигурации: " + ФайлНастроек);
		ЗавершитьРаботу(1);
	КонецЕсли;

	ЧтениеТекста = Новый ЧтениеТекста(ФайлНастроек, КодировкаТекста.UTF8);
	ПрефиксПараметра = "sonar.projectKey=";
	ProjectKey = "";

	Строка = ЧтениеТекста.ПрочитатьСтроку();
	Пока Строка <> Неопределено Цикл
		Если СтрНачинаетсяС(Строка, ПрефиксПараметра) Тогда
			ProjectKey = Сред(Строка, СтрДлина(ПрефиксПараметра) + 1);
			Прервать;
		КонецЕсли;
		Строка = ЧтениеТекста.ПрочитатьСтроку();
	КонецЦикла;

	ЧтениеТекста.Закрыть();

	Если НЕ ЗначениеЗаполнено(ProjectKey) Тогда
		Сообщить("Не найден параметр sonar.projectKey в файле " + ФайлНастроек);
		ЗавершитьРаботу(1);
	КонецЕсли;

	Возврат ProjectKey;

КонецФункции

// Загружает одну страницу issues из SonarQube API
//
Функция ЗагрузитьСтраницуIssues(НомерPR, ProjectKey, Токен, НомерСтраницы, РазмерСтраницы)

	Соединение = Новый HTTPСоединение("https://sonarqube.dev-portal.ru", , , , , 30);
	ПутьЗапроса = "/api/issues/search?componentKeys=" + ProjectKey
		+ "&pullRequest=" + НомерPR
		+ "&p=" + НомерСтраницы
		+ "&ps=" + РазмерСтраницы;

	Запрос = Новый HTTPЗапрос(ПутьЗапроса);
	Запрос.Заголовки.Вставить("Authorization", "Bearer " + Токен);

	Ответ = Соединение.Получить(Запрос);

	Если Ответ.КодСостояния <> 200 Тогда
		Сообщить("Ошибка HTTP: " + Ответ.КодСостояния);
		Сообщить(Ответ.ПолучитьТелоКакСтроку());
		ЗавершитьРаботу(1);
	КонецЕсли;

	ЧтениеJSON = Новый ЧтениеJSON();
	ЧтениеJSON.УстановитьСтроку(Ответ.ПолучитьТелоКакСтроку());
	Данные = ПрочитатьJSON(ЧтениеJSON);
	ЧтениеJSON.Закрыть();

	Возврат Данные;

КонецФункции

// Загружает все страницы issues для указанного Pull Request
//
Функция ЗагрузитьIssues(НомерPR, ProjectKey, Токен)

	РазмерСтраницы = 500;
	НомерСтраницы = 1;
	ВсеIssues = Новый Массив;
	Результат = Неопределено;
	Всего = 0;

	Пока Истина Цикл
		ДанныеСтраницы = ЗагрузитьСтраницуIssues(
			НомерPR,
			ProjectKey,
			Токен,
			НомерСтраницы,
			РазмерСтраницы);

		Если Результат = Неопределено Тогда
			Результат = ДанныеСтраницы;
			Всего = ДанныеСтраницы["total"];
		КонецЕсли;

		IssuesСтраницы = ДанныеСтраницы["issues"];
		Для Каждого Issue Из IssuesСтраницы Цикл
			ВсеIssues.Добавить(Issue);
		КонецЦикла;

		Если ВсеIssues.Количество() >= Всего
			ИЛИ IssuesСтраницы.Количество() = 0 Тогда
			Прервать;
		КонецЕсли;

		НомерСтраницы = НомерСтраницы + 1;
	КонецЦикла;

	Если ВсеIssues.Количество() <> Всего Тогда
		ВызватьИсключение "Получена неполная выгрузка Sonar issues: ожидалось "
			+ Всего + ", получено " + ВсеIssues.Количество();
	КонецЕсли;

	Результат.Вставить("issues", ВсеIssues);
	Результат.Вставить("total", Всего);

	Возврат Результат;

КонецФункции

// Возвращает evidence анализа Pull Request через тот же HTTP-клиент и тот же
// SONAR_TOKEN. Ошибка получения scanner context не отменяет уже полную
// выгрузку issues: вызывающий обязан трактовать такой report как unverified.
//
// SonarQube scanner context содержит фактические scanner properties. Для
// сопоставления с GitLab пригодны только commit SHA из sonar.analysis.revision
// или sonar.scm.revision; время анализа само по себе недостаточно.
//
Функция ПолучитьAnalysisEvidence(НомерPR, ProjectKey, Токен)

	Evidence = Новый Структура;
	Evidence.Вставить("status", "unavailable");
	Evidence.Вставить("reason", "analysis evidence is unavailable");
	Evidence.Вставить("taskId", "");
	Evidence.Вставить("analysisId", "");
	Evidence.Вставить("executedAt", "");
	Evidence.Вставить("revision", "");
	Evidence.Вставить("revisionProperty", "");
	ТекущаяЗадача = Неопределено;
	ИдентификаторЗадачи = "";
	ИдентификаторАнализа = "";
	ВремяВыполнения = "";
	КонтекстСканера = "";

	Соединение = Новый HTTPСоединение("https://sonarqube.dev-portal.ru", , , , , 30);
	ПутьЗадачи = "/api/ce/component?component=" + ProjectKey
		+ "&pullRequest=" + НомерPR;
	ЗапросЗадачи = Новый HTTPЗапрос(ПутьЗадачи);
	ЗапросЗадачи.Заголовки.Вставить("Authorization", "Bearer " + Токен);
	ОтветЗадачи = Соединение.Получить(ЗапросЗадачи);

	Если ОтветЗадачи.КодСостояния <> 200 Тогда
		Evidence["reason"] = "CE task request returned HTTP " + ОтветЗадачи.КодСостояния;
		Возврат Evidence;
	КонецЕсли;

	ЧтениеJSON = Новый ЧтениеJSON();
	ЧтениеJSON.УстановитьСтроку(ОтветЗадачи.ПолучитьТелоКакСтроку());
	Попытка
		ДанныеЗадачи = ПрочитатьJSON(ЧтениеJSON);
	Исключение
		ЧтениеJSON.Закрыть();
		Evidence["reason"] = "CE task response is not valid JSON";
		Возврат Evidence;
	КонецПопытки;
	ЧтениеJSON.Закрыть();

	Если НЕ ДанныеЗадачи.Свойство("current", ТекущаяЗадача)
		ИЛИ НЕ ТекущаяЗадача.Свойство("id", ИдентификаторЗадачи)
		ИЛИ НЕ ЗначениеЗаполнено(ИдентификаторЗадачи) Тогда
		Evidence["reason"] = "CE task response has no current task id";
		Возврат Evidence;
	КонецЕсли;

	Evidence["taskId"] = ИдентификаторЗадачи;
	Если ТекущаяЗадача.Свойство("analysisId", ИдентификаторАнализа) Тогда
		Evidence["analysisId"] = ИдентификаторАнализа;
	КонецЕсли;
	Если ТекущаяЗадача.Свойство("executedAt", ВремяВыполнения) Тогда
		Evidence["executedAt"] = ВремяВыполнения;
	КонецЕсли;

	ПутьКонтекста = "/api/ce/scanner_context?taskId=" + ИдентификаторЗадачи;
	ЗапросКонтекста = Новый HTTPЗапрос(ПутьКонтекста);
	ЗапросКонтекста.Заголовки.Вставить("Authorization", "Bearer " + Токен);
	ОтветКонтекста = Соединение.Получить(ЗапросКонтекста);
	Если ОтветКонтекста.КодСостояния <> 200 Тогда
		Evidence["reason"] = "scanner context request returned HTTP " + ОтветКонтекста.КодСостояния;
		Возврат Evidence;
	КонецЕсли;

	ЧтениеJSON = Новый ЧтениеJSON();
	ЧтениеJSON.УстановитьСтроку(ОтветКонтекста.ПолучитьТелоКакСтроку());
	Попытка
		ДанныеКонтекста = ПрочитатьJSON(ЧтениеJSON);
	Исключение
		ЧтениеJSON.Закрыть();
		Evidence["reason"] = "scanner context response is not valid JSON";
		Возврат Evidence;
	КонецПопытки;
	ЧтениеJSON.Закрыть();

	Если НЕ ДанныеКонтекста.Свойство("scannerContext", КонтекстСканера)
		ИЛИ ТипЗнч(КонтекстСканера) <> Тип("Строка") Тогда
		Evidence["reason"] = "scanner context has no text properties";
		Возврат Evidence;
	КонецЕсли;

	Для Каждого СтрокаКонтекста Из СтрРазделить(КонтекстСканера, Символы.ПС) Цикл
		СтрокаКонтекста = СокрЛП(СтрокаКонтекста);
		Для Каждого ИмяСвойства Из Новый Массив("sonar.analysis.revision", "sonar.scm.revision") Цикл
			Префикс = ИмяСвойства + "=";
			Если СтрНачинаетсяС(СтрокаКонтекста, Префикс) Тогда
				Evidence["revision"] = Сред(СтрокаКонтекста, СтрДлина(Префикс) + 1);
				Evidence["revisionProperty"] = ИмяСвойства;
				Evidence["status"] = "available";
				Evidence["reason"] = "";
				Возврат Evidence;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Evidence["reason"] = "scanner context has no analyzed revision";
	Возврат Evidence;

КонецФункции

// Сохраняет данные issues в JSON-файл
//
Функция СохранитьВФайл(Данные, НомерPR)

	ПутьКаталога = Новый Файл(КаталогРезультатов);
	Если НЕ ПутьКаталога.Существует() Тогда
		СоздатьКаталог(КаталогРезультатов);
	КонецЕсли;

	ИмяФайла = "issues-pr-" + НомерPR + ".json";
	ПолныйПуть = КаталогРезультатов + "\" + ИмяФайла;

	ЗаписьJSON = Новый ЗаписьJSON();
	ЗаписьJSON.ОткрытьФайл(ПолныйПуть, , , Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Авто));
	ЗаписатьJSON(ЗаписьJSON, Данные);
	ЗаписьJSON.Закрыть();

	Возврат ПолныйПуть;

КонецФункции

// Выводит статистику по загруженным issues в консоль
//
Процедура ВывестиСтатистику(Данные)

	Всего = Данные["total"];
	Issues = Данные["issues"];

	КоличествоBug = 0;
	КоличествоVulnerability = 0;
	КоличествоCodeSmell = 0;

	Для Каждого Issue Из Issues Цикл
		ТипIssue = Issue["type"];
		Если ТипIssue = "BUG" Тогда
			КоличествоBug = КоличествоBug + 1;
		ИначеЕсли ТипIssue = "VULNERABILITY" Тогда
			КоличествоVulnerability = КоличествоVulnerability + 1;
		ИначеЕсли ТипIssue = "CODE_SMELL" Тогда
			КоличествоCodeSmell = КоличествоCodeSmell + 1;
		КонецЕсли;
	КонецЦикла;

	Сообщить("Всего issues: " + Всего);
	Сообщить("BUG: " + КоличествоBug
		+ ", VULNERABILITY: " + КоличествоVulnerability
		+ ", CODE_SMELL: " + КоличествоCodeSmell);

КонецПроцедуры

// Главная процедура скрипта
//
Процедура Главная()

	ФайлНастроек = "sonar-project.properties";
	КаталогРезультатов = "out\sonar-reports";

	Парсер = Новый ПарсерАргументовКоманднойСтроки();
	Парсер.ДобавитьИменованныйПараметр("-pr");
	Парсер.ДобавитьИменованныйПараметр("-output-dir");
	Параметры = Парсер.Разобрать(АргументыКоманднойСтроки);

	НомерPR = Параметры["-pr"];
	Если НЕ ЗначениеЗаполнено(НомерPR) Тогда
		Сообщить("Использование: oscript download-sonar-issues.os -pr <номер_PR> [-output-dir <каталог>]");
		ЗавершитьРаботу(1);
	КонецЕсли;
	Если ЗначениеЗаполнено(Параметры["-output-dir"]) Тогда
		КаталогРезультатов = Параметры["-output-dir"];
	КонецЕсли;

	Токен = ПолучитьПеременнуюСреды("SONAR_TOKEN");
	Если НЕ ЗначениеЗаполнено(Токен) Тогда
		Сообщить("Не установлена переменная среды SONAR_TOKEN");
		ЗавершитьРаботу(1);
	КонецЕсли;

	Попытка
		ProjectKey = ПолучитьProjectKey();
		ДанныеIssues = ЗагрузитьIssues(НомерPR, ProjectKey, Токен);
		Отчет = Новый Структура;
		Отчет.Вставить("schema", "sonar-pr-issues.v2");
		Отчет.Вставить("pullRequest", Строка(НомерPR));
		Отчет.Вставить("projectKey", ProjectKey);
		Отчет.Вставить("total", ДанныеIssues["total"]);
		Отчет.Вставить("issues", ДанныеIssues["issues"]);
		Отчет.Вставить("analysis", ПолучитьAnalysisEvidence(НомерPR, ProjectKey, Токен));
		ПутьКФайлу = СохранитьВФайл(Отчет, НомерPR);
		Сообщить("Результат сохранён в: " + ПутьКФайлу);
		ВывестиСтатистику(Отчет);
	Исключение
		Сообщить("Ошибка: " + ОписаниеОшибки());
		ЗавершитьРаботу(1);
	КонецПопытки;

КонецПроцедуры

Главная();
