{
  "permissions": {
    "allow": [
      "Bash(.claude/scripts/aidd-bootstrap-ticket.cmd:*)",
      "Bash(.claude\\scripts\\aidd-bootstrap-ticket.cmd:*)",
      "Bash(.claude/scripts/aidd-inspect.cmd:*)",
      "Bash(.claude\\scripts\\aidd-inspect.cmd:*)",
      "Bash(.claude/scripts/gitlab-mr-review.cmd:*)",
      "Bash(.claude\\scripts\\gitlab-mr-review.cmd:*)",
      "Bash(.claude/scripts/http-smoke.cmd:*)",
      "Bash(.claude\\scripts\\http-smoke.cmd:*)",
      "Bash(.claude/scripts/new-guid.cmd:*)",
      "Bash(.claude\\scripts\\new-guid.cmd:*)",
      "Bash(.claude/scripts/commit-block.sh:*)",
      "Bash(.claude\\scripts\\commit-block.sh:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git rev-parse:*)",
      "Bash(git merge-base:*)",
      "Bash(git remote:*)",
      "Bash(git ls-files:*)",
      "Bash(git describe:*)",
      "Bash(git name-rev:*)",
      "Bash(git for-each-ref:*)",
      "mcp__1c-rsv__*",
      "mcp__1c-debug-info__get_configuration_info",
      "mcp__1c-debug-info__get_event_log",
      "mcp__1c-debug-info__get_metadata_tree",
      "mcp__1c-debug-info__get_object_structure",
      "mcp__1c-debug-info__get_form_structure",
      "mcp__1c-debug-info__validate_query",
      "mcp__1c-debug-info__bsl_syntax_help"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Write|Edit|MultiEdit|Glob|Grep",
        "hooks": [
          {
            "type": "command",
            "command": ".claude\\hooks\\block-inline-file-inspection.ps1",
            "shell": "powershell"
          }
        ]
      },
      {
        "matcher": "mcp__1c-rsv__.*",
        "hooks": [
          {
            "type": "command",
            "command": ".claude\\hooks\\block-inline-file-inspection.ps1",
            "shell": "powershell"
          }
        ]
      }
    ]
  }
}
